# Experimental CPU-only Python 3.13 distroless runtime. No production promotion.
ARG PYTHON_VERSION=3.13.14
FROM python:${PYTHON_VERSION}-slim-trixie@sha256:9662417aace5ae7b8e2609cce472b72a8958e134ba372808abe9cc1a0c0125e6 AS builder
ENV HASHORB_BUILD_CUDA=0 PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
COPY pyproject.toml setup.py MANIFEST.in README.md ./
COPY src ./src
RUN python -m pip wheel --wheel-dir /wheels . \
    && python -m pip install --no-index --find-links=/wheels --target=/opt/hashorb hashorb

# This image supplies Debian's Python 3.13 at /usr/bin/python3, not /usr/local/bin.
# Pin the resolved OCI digest before promotion; this branch is a candidate only.
FROM gcr.io/distroless/python3-debian13:nonroot AS runtime
ENV PYTHONPATH=/opt/hashorb PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
COPY --from=builder /opt/hashorb /opt/hashorb
WORKDIR /app
USER 10001:10001
VOLUME ["/app/logs"]
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/usr/bin/python3", "-m", "hashorb", "doctor", "--log-dir", "/app/logs"]
ENTRYPOINT ["/usr/bin/python3", "-m", "hashorb"]
CMD ["doctor", "--log-dir", "/app/logs"]
