# Required only for live Stratum commands. Keep private keys and wallet secrets out.
HASHPHERE_STRATUM_HOST=stratum.ckpool.org
HASHPHERE_STRATUM_PORT=3333
HASHPHERE_BITCOIN_ADDRESS=YOUR_BITCOIN_ADDRESS
HASHPHERE_WORKER_NAME=auto
HASHPHERE_STRATUM_PASSWORD=x

# Optional performance profile. Presets must not be combined with Custom controls.
# HASHPHERE_COMPUTE_PROFILE=auto

# Search order is independent of the profile and compute backend.
HASHPHERE_SEARCH_STRATEGY=sequential

# Custom profile controls. Uncomment the profile plus every control required by
# the selected backend. Lite rejects these controls; Auto and Max accept only an
# explicit CUDA device or CUDA device list.
# HASHPHERE_COMPUTE_PROFILE=custom
#
# HASHPHERE_COMPUTE_BACKEND=cuda
# HASHPHERE_COMPUTE_WORKERS=2
# HASHPHERE_CUDA_DEVICE=0
# HASHPHERE_CUDA_DEVICES=0,1
# HASHPHERE_CUDA_THREADS_PER_BLOCK=256
# HASHPHERE_CHUNK_SIZE=500000000
# HASHPHERE_INTER_RANGE_DELAY_SECONDS=0

# Lifecycle limits, liveness thresholds, reconnect policy, and log destinations
# are explicit CLI options. They are intentionally not environment settings.

# Bitcoin Core true solo is separate from Stratum. The RPC endpoint defaults to
# loopback only; payout and authentication have no defaults. Choose exactly one
# authentication method. Keep these values commented until intentionally used.
# HASHPHERE_BITCOIN_RPC_HOST=127.0.0.1
# HASHPHERE_BITCOIN_RPC_PORT=8332
# HASHPHERE_BITCOIN_RPC_TIMEOUT_SECONDS=10
# HASHPHERE_BITCOIN_RPC_USER=YOUR_RPC_USER
# HASHPHERE_BITCOIN_RPC_PASSWORD=YOUR_RPC_PASSWORD
# HASHPHERE_BITCOIN_RPC_COOKIE_FILE=EXPLICIT_COOKIE_PATH
# HASHPHERE_SOLO_PAYOUT_ADDRESS=YOUR_ADDRESS_FOR_THE_CONNECTED_CHAIN

# Readiness, mining, and complete-block submission have separate exact opt-ins.
# HASHPHERE_ENABLE_BITCOIN_RPC_CHECK=1
# HASHPHERE_ENABLE_TRUE_SOLO=1
# HASHPHERE_ENABLE_BLOCK_SUBMISSION=1
