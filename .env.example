HASHPHERE_STRATUM_HOST=stratum.ckpool.org
HASHPHERE_STRATUM_PORT=3333

HASHPHERE_BITCOIN_ADDRESS=YOUR_BITCOIN_ADDRESS
HASHPHERE_WORKER_NAME=auto
HASHPHERE_STRATUM_PASSWORD=x

HASHPHERE_COMPUTE_BACKEND=auto
HASHPHERE_COMPUTE_WORKERS=2
HASHPHERE_CUDA_DEVICE=0
# Required only with HASHPHERE_COMPUTE_BACKEND=cuda-multi, for example 0,1
HASHPHERE_CUDA_DEVICES=0
HASHPHERE_COMPUTE_PROFILE=lite
HASHPHERE_SEARCH_STRATEGY=sequential
