# Required only for live Stratum commands. Keep private keys and wallet secrets out.
HASHORB_STRATUM_HOST=stratum.ckpool.org
HASHORB_STRATUM_PORT=3333
HASHORB_BITCOIN_ADDRESS=YOUR_BITCOIN_ADDRESS
HASHORB_WORKER_NAME=auto
HASHORB_STRATUM_PASSWORD=x

# Optional performance profile. Presets must not be combined with Custom controls.
# HASHORB_COMPUTE_PROFILE=auto

# Search order is independent of the profile and compute backend.
# Values: sequential, orbiting-bit, fibonacci-bounce, or auto (sequential alias).
HASHORB_SEARCH_STRATEGY=sequential

# Custom profile controls. Uncomment the profile plus every control required by
# the selected backend. Lite rejects these controls; Auto and Max accept only an
# explicit CUDA device or CUDA device list.
# HASHORB_COMPUTE_PROFILE=custom
#
# HASHORB_COMPUTE_BACKEND=cuda
# HASHORB_COMPUTE_WORKERS=2
# HASHORB_CUDA_DEVICE=0
# HASHORB_CUDA_DEVICES=0,1
# HASHORB_CUDA_THREADS_PER_BLOCK=256
# HASHORB_CHUNK_SIZE=500000000
# HASHORB_INTER_RANGE_DELAY_SECONDS=0

# Lifecycle limits, liveness thresholds, reconnect policy, and log destinations
# are explicit CLI options. They are intentionally not environment settings.

# Bitcoin Core true solo is separate from Stratum. The RPC endpoint defaults to
# loopback only; payout and authentication have no defaults. Choose exactly one
# authentication method. Keep these values commented until intentionally used.
# HASHORB_BITCOIN_RPC_HOST=127.0.0.1
# HASHORB_BITCOIN_RPC_PORT=8332
# HASHORB_BITCOIN_RPC_TIMEOUT_SECONDS=10
# HASHORB_BITCOIN_RPC_USER=YOUR_RPC_USER
# HASHORB_BITCOIN_RPC_PASSWORD=YOUR_RPC_PASSWORD
# HASHORB_BITCOIN_RPC_COOKIE_FILE=EXPLICIT_COOKIE_PATH
# HASHORB_SOLO_PAYOUT_ADDRESS=YOUR_ADDRESS_FOR_THE_CONNECTED_CHAIN

# Readiness, hash-only compute, mining, and block submission have separate opt-ins.
# HASHORB_ENABLE_BITCOIN_RPC_CHECK=1
# HASHORB_ENABLE_TRUE_SOLO_HASHING=1
# HASHORB_ENABLE_TRUE_SOLO=1
# HASHORB_ENABLE_BLOCK_SUBMISSION=1
